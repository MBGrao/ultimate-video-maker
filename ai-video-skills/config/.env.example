# ai-video-skills: every API key the catalog can use. Copy to .env.local and fill only what you buy.
# cp config/.env.example config/.env.local    (never commit .env.local)

# ===== Core keys PIPELINE.md switches on (see PAID-APIS.md buying guide) =====
ELEVENLABS_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
HEYGEN_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
REMOVE_BG_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
HF_TOKEN=

